---
// Copyright 2026 The radiusward Authors
// SPDX-License-Identifier: Apache-2.0
// The documentation front page: four ways in by what the reader wants, then every section.
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { DOCS_NAV } from '../../nav';
const docs = new Map((await getCollection('docs')).map((d) => [d.id, d.data]));
const about: Record<string, string> = {
	Start: 'What it is, whether it fits, and a cluster on your laptop in ten minutes.',
	Concepts: 'How the parts fit together, and why.',
	Reliability: 'What a confirmation guarantees, what happens when something fails, and the evidence.',
	Authentication: 'From the credentials and clients you have to the method that fits.',
	Develop: 'radiusward inside your tests: logins, accounting, EAP and failover against a real server, and your own stores and sinks.',
	Deployment: 'Docker for an evaluation; Kubernetes for production.',
	Operate: 'Signals to watch, recovery to practise, upgrades, and a checklist before production.',
	Security: 'Reporting, defaults, hardening, and the limits stated openly.',
	Community: 'Building, contributing, and where the project is going.',
	Reference: 'Every configuration key, metric and alert — in the server repository, next to the code.',
};
const paths = [
	{
		title: 'I want to know what it is',
		text: 'A plain explanation of what radiusward does for a network, who it is for, and when something simpler serves better.',
		links: [
			{ label: 'What radiusward is', href: '/docs/start/overview/' },
			{ label: 'Is it a fit?', href: '/docs/start/fit/' },
			{ label: 'Architecture', href: '/docs/concepts/architecture/' },
		],
	},
	{
		title: 'I want to run it',
		text: 'A complete cluster on your laptop with Docker, your first session record, your first login — then the platform you deploy on.',
		links: [
			{ label: 'Quickstart: first accounting request', href: '/docs/start/quickstart/' },
			{ label: 'First authentication', href: '/docs/start/first-authentication/' },
			{ label: 'Kubernetes', href: '/docs/deployment/kubernetes/' },
		],
	},
	{
		title: 'I want to know what I can rely on',
		text: 'Exactly what is promised when a record is confirmed, what each failure does, and the published tests behind every claim.',
		links: [
			{ label: 'The accounting contract', href: '/docs/reliability/accounting-contract/' },
			{ label: 'Failure behaviour', href: '/docs/reliability/failure-behaviour/' },
			{ label: 'Evidence: tests and benchmarks', href: '/docs/reliability/evidence/' },
		],
	},
	{
		title: 'I want to build on it',
		text: 'A real radiusward inside your JUnit tests for your NAS, portal or billing code, every EAP method from the device side, and your own user directory and accounting store.',
		links: [
			{ label: 'Develop with radiusward', href: '/docs/develop/overview/' },
			{ label: 'Test your NAS or application', href: '/docs/develop/testing/' },
			{ label: 'Plug in your own code', href: '/docs/develop/plugins/' },
		],
	},
];
---
<Base title="Documentation" description="radiusward documentation: what it is, how to run it on Docker and Kubernetes, which authentication method fits your clients, what a confirmation guarantees, how to operate and secure it, how to test against it and extend it, and how to contribute." section="docs">
	<div class="container page">
		<span class="eyebrow">Documentation</span>
		<h1>Everything you need to evaluate, run and operate radiusward.</h1>
		<p class="intro">
			Written for the people who run networks. Each page says what it is based on and links to the source in the
			server repository; press <kbd>⌘K</kbd> to search all of it.
		</p>

		<section class="paths">
			<h2>Start here</h2>
			<div class="ways">
				{paths.map((p) => (
					<article>
						<h3>{p.title}</h3>
						<p>{p.text}</p>
						<ol>{p.links.map((l) => <li><a href={l.href}>{l.label} →</a></li>)}</ol>
					</article>
				))}
			</div>
		</section>

		<h2 class="all">All sections</h2>
		{DOCS_NAV.map((s) => (
			<section class="group">
				<div class="group-head">
					<h3>{s.label}</h3>
					<p>{about[s.label]}</p>
				</div>
				<div class="grid">
					{s.items.map((i) =>
						'slug' in i
							? <a href={`/docs/${i.slug}/`}><strong>{i.label} →</strong><span>{docs.get(i.slug)?.description}</span></a>
							: <a href={i.href}><strong>{i.label}</strong><span>In the server repository, next to the code.</span></a>
					)}
				</div>
			</section>
		))}
	</div>
</Base>
<style>
	.page { padding-top: var(--space-16); }
	h1 { font-size: var(--text-2xl); max-width: 24ch; letter-spacing: -0.045em; }
	.intro { margin-top: var(--space-5); max-width: 62ch; color: var(--color-text-muted); }
	kbd { padding: 0.1em 0.4em; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); font-family: var(--font-code); font-size: 0.85em; }
	.paths { margin-top: var(--space-12); }
	.paths h2, .all { font-size: var(--text-xl); margin-bottom: var(--space-5); }
	.all { margin-top: var(--space-16); }
	.ways { display: grid; gap: var(--space-4); grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.ways article { padding: var(--space-5) var(--space-6); border: 1px solid var(--color-border); border-top: 4px solid var(--color-primary); border-radius: var(--radius-md); background: var(--color-surface); }
	.ways h3 { font-size: var(--text-lg); }
	.ways p { margin-top: var(--space-2); color: var(--color-text-muted); font-size: var(--text-sm); }
	.ways ol { margin: var(--space-4) 0 0; padding-left: var(--space-5); font-size: var(--text-sm); }
	.ways li + li { margin-top: var(--space-2); }
	.ways ol a { color: var(--color-primary); font-weight: 700; }
	.group { display: grid; grid-template-columns: 240px 1fr; gap: var(--space-8); padding-block: var(--space-8); border-top: 1px solid var(--color-divider); }
	.group h3 { font-size: var(--text-lg); }
	.group-head p { margin-top: var(--space-2); color: var(--color-text-muted); font-size: var(--text-sm); }
	.grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
	.grid a { display: grid; align-content: start; gap: var(--space-2); padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
	.grid a:hover { border-color: var(--color-primary); }
	.grid span { color: var(--color-text-muted); font-size: var(--text-sm); }
	@media (max-width: 760px) { .group { grid-template-columns: 1fr; gap: var(--space-4); } .ways { grid-template-columns: 1fr; } }
</style>
