import Base from '../../layouts/Base.astro';
import ScenarioDiagram from '../../components/ScenarioDiagram.astro';
import { REPORTS } from '../../consts';
import { scenarios, MATRIX } from '../../data/scenarios';

---
<Base title="Reliability" description="What survives a failure in radiusward and what stops: the accounting contract, six failure scenarios with assumptions, recovery and limits, and the published tests and benchmarks behind them." section="reliability">
	<div class="container">
		<section class="page-hero">
			<span class="eyebrow">Reliability</span>
			<h1>Know what survives.<br />Know what stops.</h1>
			<p>
				If a server dies, what happens to the logins and to the session records? This page answers that for each failure
				radiusward is built for — what pauses, what continues, what recovers — and shows the tests behind each answer.
			</p>
			<p class="rule"><strong>The one rule:</strong> a session record is confirmed to the device only after it is stored on two of the
				three servers, and nothing confirmed is lost while two of them are up. Everything below follows from it.</p>
			<div class="actions">
				<a class="btn btn-primary" href="/docs/reliability/accounting-contract/">Read the accounting contract →</a>
				<a class="btn" href={`${REPORTS}/`}>Open the test reports ↗</a>
			</div>
		</section>

		<section class="explorer" data-explorer>
			<h2>What happens when…</h2>
			<div class="tabs" role="tablist" aria-label="Failure scenarios" hidden>
				{scenarios.map((s, i) => (
					<button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'}>{s.tab}</button>
				))}
			</div>
			{scenarios.map((s) => (
				<article class="panel" id={`panel-${s.id}`} role="tabpanel" aria-labelledby={`tab-${s.id}`}>
					<div class="panel-grid">
						<ScenarioDiagram {...s.diagram} />
						<div>
							<h3>{s.title}</h3>
							<dl>
								<dt>What to expect</dt><dd>{s.expect}</dd>
								<dt>Assumptions</dt><dd>{s.assumptions}</dd>
								<dt>Recovery</dt><dd>{s.recovery}</dd>
								<dt>Limits</dt><dd>{s.limits}</dd>
								<dt>Evidence</dt><dd>{s.evidence}</dd>
							</dl>
							<p class="links"><a href="/docs/reliability/failure-behaviour/">Read the explanation →</a> <a href={s.source.href}>{s.source.label} ↗</a></p>
						</div>
					</div>
				</article>
			))}
		</section>

		<section>
			<h2>The evidence</h2>
			<div class="evidence">
				<a href={`${REPORTS}/linux/`}><strong>Fault injection ↗</strong><span>Nightly on Linux: power loss of all members with LazyFS, partitions, full disks, overload, a PostgreSQL outage.</span></a>
				<a href={`${REPORTS}/k8s/`}><strong>Kubernetes ↗</strong><span>Nightly on kind under load: leader killed, members and gateways rolled, a volume replaced, a lost quorum restored.</span></a>
				<a href={`${REPORTS}/benchmarks/`}><strong>Benchmarks ↗</strong><span>Throughput and latency ladders and a leader killed under load, with the machine and the method.</span></a>
				<a href={MATRIX}><strong>Failure matrix ↗</strong><span>Every failure case, the expected behaviour and the test that checks it.</span></a>
			</div>
			<p class="caveat">Evidence published by the project is not an independent audit, and results from one environment are not a guarantee for another.</p>
		</section>
	</div>
</Base>

<script>
	// progressive enhancement: without JavaScript every scenario is shown one under another
	const root = document.querySelector<HTMLElement>('[data-explorer]')!;
	const list = root.querySelector<HTMLElement>('[role=tablist]')!;
	const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
	const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
	list.hidden = false;
	root.classList.add('js');
	function select(i: number, focus = false, remember = true) {
		tabs.forEach((t, j) => {
			t.setAttribute('aria-selected', String(i === j));
			t.tabIndex = i === j ? 0 : -1;
			panels[j].hidden = i !== j;
		});
		if (focus) tabs[i].focus();
		if (remember) history.replaceState(null, '', `#${panels[i].id.replace('panel-', '')}`);
	}
	tabs.forEach((t, i) => {
		t.addEventListener('click', () => select(i));
		t.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
			if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
		});
	});
	const start = panels.findIndex((p) => p.id === `panel-${location.hash.slice(1)}`);
	select(Math.max(0, start), false, start >= 0);
</script>

<style>
	.page-hero { padding-block: var(--space-16) var(--space-10); max-width: 860px; }
	.page-hero h1 { font-size: var(--text-2xl); letter-spacing: -0.05em; }
	.page-hero p { margin-top: var(--space-5); max-width: 60ch; color: var(--color-text-muted); }
	.rule { margin-top: var(--space-5) !important; padding: var(--space-4) var(--space-5); border-left: 4px solid var(--color-primary); border-radius: var(--radius-sm); background: var(--color-primary-tint); color: var(--color-text) !important; max-width: 66ch !important; font-size: var(--text-sm); }
	.rule strong { color: var(--color-primary); }
	.actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-top: var(--space-8); }
	section + section { margin-top: var(--space-16); }
	h2 { font-size: var(--text-xl); margin-bottom: var(--space-6); }
	.tabs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-5); }
	.tabs[hidden] { display: none; }
	.tabs button { min-height: 42px; padding: var(--space-2) var(--space-4); border: 1px solid var(--color-border); border-radius: 999rem; background: transparent; font-size: var(--text-sm); }
	.tabs button:hover { background: var(--color-surface-2); }
	.tabs button[aria-selected='true'] { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-on-primary); }
	.panel { padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
	.explorer:not(.js) .panel + .panel { margin-top: var(--space-4); }
	.panel-grid { display: grid; grid-template-columns: minmax(260px, 0.85fr) 1.3fr; gap: var(--space-8); align-items: start; }
	.panel h3 { font-size: var(--text-lg); margin-bottom: var(--space-4); }
	dl { display: grid; gap: var(--space-1); font-size: var(--text-sm); }
	dt { margin-top: var(--space-3); color: var(--color-primary); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
	dt:first-child { margin-top: 0; }
	dd { margin: 0; color: var(--color-text-muted); }
	.links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-top: var(--space-5); font-size: var(--text-sm); }
	.links a { color: var(--color-primary); font-weight: 700; }
	.evidence { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
	.evidence a { display: grid; gap: var(--space-2); padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
	.evidence a:hover { border-color: var(--color-primary); }
	.evidence span { color: var(--color-text-muted); font-size: var(--text-sm); }
	.caveat { margin-top: var(--space-6); color: var(--color-text-faint); font-size: var(--text-sm); }
	@media (max-width: 860px) { .panel-grid { grid-template-columns: 1fr; } }
</style>
