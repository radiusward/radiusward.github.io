import Base from './Base.astro';
import { DOCS_NAV, DOCS_ORDER } from '../nav';
import { RELEASE, RELEASE_URL, REPO } from '../consts';

interface Props {
	slug: string;
	title: string;
	description: string;
	source?: string;
	draft?: boolean;
	headings: { depth: number; slug: string; text: string }[];
}
const { slug, title, description, source, draft, headings } = Astro.props;
const index = DOCS_ORDER.findIndex((d) => d.slug === slug);
const current = DOCS_ORDER[index];
const prev = index > 0 ? DOCS_ORDER[index - 1] : undefined;
const next = index >= 0 && index < DOCS_ORDER.length - 1 ? DOCS_ORDER[index + 1] : undefined;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const edit = `https://github.com/radiusward/radiusward.github.io/edit/main/src/content/docs/${slug}.mdx`;
---
<Base
	title={title}
	description={description}
	section={slug.startsWith('reliability/') ? 'reliability' : 'docs'}
	type="article"
	noindex={draft}
	jsonld={[
		{ '@type': 'TechArticle', headline: title, description, url: new URL(`/docs/${slug}/`, Astro.site).toString(), inLanguage: 'en', isPartOf: { '@type': 'WebSite', name: 'radiusward' }, license: 'https://creativecommons.org/licenses/by/4.0/' },
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Documentation', item: new URL('/docs/', Astro.site).toString() },
				{ '@type': 'ListItem', position: 2, name: title, item: new URL(`/docs/${slug}/`, Astro.site).toString() },
			],
		},
	]}
>
	<div class="container docs-shell">
		<aside class="docs-sidebar" aria-label="Documentation">
			<details class="docs-menu" open>
				<summary>Documentation menu</summary>
				<a class="version" href={RELEASE_URL}><strong>{RELEASE.label}</strong><span>{RELEASE.tag}</span></a>
				<nav>
					{DOCS_NAV.map((s) => (
						<>
							<div class="label">{s.label}</div>
							{s.items.map((i) => (
								'slug' in i
									? <a href={`/docs/${i.slug}/`} aria-current={i.slug === slug ? 'page' : undefined}>{i.label}</a>
									: <a href={i.href}>{i.label}</a>
							))}
						</>
					))}
				</nav>
			</details>
		</aside>

		<article class="doc">
			<div class="breadcrumbs"><a href="/docs/">Documentation</a><span>/</span><span>{current?.section}</span></div>
			<h1>{title}</h1>
			<p class="lead">{description}</p>
			{toc.length > 0 && (
				<details class="toc-mobile">
					<summary>On this page</summary>
					<nav aria-label="On this page">{toc.map((h) => <a class={`d${h.depth}`} href={`#${h.slug}`}>{h.text}</a>)}</nav>
				</details>
			)}
			<div class="prose"><slot /></div>
			<div class="doc-bottom">
				<p class="links">
					<a href={edit}>Edit this page ↗</a>
					{source && <a href={`${REPO}/blob/main/${source}`}>Source in the server repository ↗</a>}
				</p>
				<div class="pager">
					{prev && <a href={`/docs/${prev.slug}/`}><small>Previous</small>← {prev.label}</a>}
					{next && <a class="next" href={`/docs/${next.slug}/`}><small>Next</small>{next.label} →</a>}
				</div>
			</div>
		</article>

		<aside class="doc-toc" aria-label="On this page">
			{toc.length > 0 && (
				<>
					<strong>On this page</strong>
					{toc.map((h) => <a class={`d${h.depth}`} href={`#${h.slug}`}>{h.text}</a>)}
				</>
			)}
		</aside>
	</div>
</Base>

<script>
	// copy buttons on code blocks, anchors on headings, the menu collapsed on small screens
	document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
		const b = document.createElement('button');
		b.className = 'copy';
		b.type = 'button';
		b.textContent = 'Copy';
		b.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
				b.textContent = 'Copied';
			} catch {
				b.textContent = 'Select and copy';
			}
			setTimeout(() => (b.textContent = 'Copy'), 1800);
		});
		pre.append(b);
	});
	document.querySelectorAll<HTMLElement>('.prose :is(h2, h3)[id]').forEach((h) => {
		const a = document.createElement('a');
		a.className = 'anchor';
		a.href = `#${h.id}`;
		a.textContent = '#';
		a.setAttribute('aria-label', `Link to “${h.textContent}”`);
		h.append(a);
	});
	if (matchMedia('(max-width: 860px)').matches) document.querySelector('.docs-menu')?.removeAttribute('open');
</script>

<style>
	.docs-shell { display: grid; grid-template-columns: 230px minmax(0, 1fr) 190px; gap: var(--space-12); align-items: start; padding-top: var(--space-8); }
	.docs-sidebar { position: sticky; top: calc(var(--header-height) + var(--space-6)); max-height: calc(100dvh - var(--header-height) - var(--space-12)); overflow-y: auto; font-size: var(--text-sm); }
	.docs-menu > summary { display: none; }
	.version { display: grid; gap: var(--space-1); padding: var(--space-3) var(--space-4); margin-bottom: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); font-size: var(--text-xs); }
	.version span { color: var(--color-primary); font-family: var(--font-code); white-space: nowrap; }
	.label { margin: var(--space-5) 0 var(--space-1); padding-inline: var(--space-3); color: var(--color-text-faint); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }
	.docs-sidebar nav a { display: flex; align-items: center; min-height: 38px; padding: var(--space-1) var(--space-3); border-radius: var(--radius-sm); color: var(--color-text-muted); }
	.docs-sidebar nav a:hover { color: var(--color-text); background: var(--color-surface-2); }
	.docs-sidebar nav a[aria-current='page'] { color: var(--color-primary); background: var(--color-primary-tint); font-weight: 700; }
	.doc { min-width: 0; padding-bottom: var(--space-8); }
	.breadcrumbs { display: flex; gap: var(--space-2); margin-bottom: var(--space-5); color: var(--color-text-muted); font-size: var(--text-xs); }
	.breadcrumbs a { color: var(--color-primary); }
	.doc h1 { font-size: var(--text-2xl); letter-spacing: -0.045em; max-width: 22ch; }
	.lead { margin: var(--space-4) 0 var(--space-8); color: var(--color-text-muted); font-size: var(--text-lg); line-height: 1.5; max-width: 62ch; }
	.doc-bottom { margin-top: var(--space-12); padding-top: var(--space-6); border-top: 1px solid var(--color-divider); font-size: var(--text-sm); }
	.links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); }
	.links a { color: var(--color-text-muted); }
	.links a:hover { color: var(--color-primary); }
	.pager { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-top: var(--space-6); }
	.pager a { display: grid; gap: var(--space-1); padding: var(--space-4) var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); font-weight: 700; }
	.pager a:hover { border-color: var(--color-primary); }
	.pager small { color: var(--color-text-faint); font-weight: 400; font-size: var(--text-xs); }
	.pager .next { grid-column: 2; text-align: right; }
	.doc-toc { position: sticky; top: calc(var(--header-height) + var(--space-6)); display: grid; gap: var(--space-2); font-size: var(--text-xs); }
	.doc-toc strong { margin-bottom: var(--space-1); }
	.doc-toc a { color: var(--color-text-muted); }
	.doc-toc a.d3 { padding-left: var(--space-3); }
	.toc-mobile { display: none; margin: calc(-1 * var(--space-4)) 0 var(--space-8); padding: var(--space-3) var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); font-size: var(--text-sm); }
	.toc-mobile summary { cursor: pointer; font-weight: 700; }
	.toc-mobile nav { display: grid; gap: var(--space-2); margin-top: var(--space-3); }
	.toc-mobile a { color: var(--color-text-muted); }
	.toc-mobile a.d3 { padding-left: var(--space-3); }
	@media (max-width: 1100px) { .docs-shell { grid-template-columns: 210px minmax(0, 1fr); gap: var(--space-8); } .doc-toc { display: none; } .toc-mobile { display: block; } }
	@media (max-width: 860px) {
		.docs-shell { grid-template-columns: 1fr; gap: var(--space-6); }
		.docs-sidebar { position: static; max-height: none; }
		.docs-menu { padding: var(--space-3) var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
		.docs-menu > summary { display: list-item; font-weight: 700; cursor: pointer; }
	}
</style>
