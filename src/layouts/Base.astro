---
// Copyright 2026 The radiusward Authors
// SPDX-License-Identifier: Apache-2.0
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';

interface Props {
	title: string;
	description: string;
	section?: 'home' | 'product' | 'docs' | 'reliability';
	/** pages kept out of search engines, the sitemap and the site search (404, drafts) */
	noindex?: boolean;
	/** Open Graph type: docs pages are articles */
	type?: 'website' | 'article';
	/** structured data (schema.org) for this page, besides the site-wide WebSite entry */
	jsonld?: Record<string, unknown>[];
}
const { title, description, section, noindex, type = 'website', jsonld = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = section === 'home' ? title : `${title} · radiusward`;
const image = new URL('/og.png', Astro.site);
const site = Astro.site!.toString();
const structured = [
	{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'radiusward', url: site },
	...jsonld.map((d) => ({ '@context': 'https://schema.org', ...d })),
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="theme-color" content="#01696f" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="radiusward" />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="radiusward — network logins and usage records that survive a server failure" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" set:html={JSON.stringify(structured)} />
		{noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />}
		<meta name="tdm-reservation" content="0" />
		<link rel="license" href="https://creativecommons.org/licenses/by/4.0/" />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
		<script is:inline>
			(() => {
				let t = null;
				try { t = localStorage.getItem('theme'); } catch {}
				document.documentElement.dataset.theme =
					t || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			})();
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<Header section={section} />
		<main id="main" tabindex="-1" data-pagefind-body={noindex ? undefined : ''}>
			<slot />
		</main>
		<Footer />
		<Search />
	</body>
</html>
