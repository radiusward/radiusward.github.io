// Every failure scenario in full, one after another, for the documentation.
import ScenarioDiagram from './ScenarioDiagram.astro';
import { scenarios } from '../data/scenarios';
---
{scenarios.map((s) => (
	<section class="scenario">
		<h2 id={s.id}>{s.title}</h2>
		<div class="grid">
			<ScenarioDiagram {...s.diagram} />
			<dl>
				<dt>What to expect</dt><dd>{s.expect}</dd>
				<dt>Assumptions</dt><dd>{s.assumptions}</dd>
				<dt>Recovery</dt><dd>{s.recovery}</dd>
				<dt>Limits</dt><dd>{s.limits}</dd>
				<dt>Evidence</dt><dd>{s.evidence} <a href={s.source.href}>{s.source.label} ↗</a></dd>
			</dl>
		</div>
	</section>
))}
<style>
	.scenario { margin-top: var(--space-12); }
	.grid { display: grid; gap: var(--space-5); margin-top: var(--space-4); }
	.grid > :global(figure) { max-width: 460px; }
	dl { margin: 0; font-size: var(--text-sm); }
	dt { margin-top: var(--space-3); color: var(--color-primary); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
	dt:first-child { margin-top: 0; }
	dd { margin: var(--space-1) 0 0; color: var(--color-text-muted); }
	dd a { color: var(--color-primary); }
</style>
