interface Props { type?: 'note' | 'tip' | 'caution'; title?: string; }
const { type = 'note', title } = Astro.props;
---
<aside class={`callout ${type}`}>
	{title && <strong>{title}</strong>}
	<div><slot /></div>
</aside>
<style>
	.callout { padding: var(--space-4) var(--space-5); border: 1px solid var(--color-border); border-left: 4px solid var(--color-text-faint); border-radius: var(--radius-md); background: var(--color-surface-2); font-size: var(--text-sm); }
	.callout.tip { border-left-color: var(--color-primary); background: var(--color-primary-tint); }
	.callout.caution { border-left-color: var(--color-caution); background: var(--color-caution-tint); }
	strong { display: block; margin-bottom: var(--space-1); color: var(--color-text); }
	div > :global(* + *) { margin-top: var(--space-2); }
</style>
