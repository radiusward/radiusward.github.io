---
// Copyright 2026 The radiusward Authors
// SPDX-License-Identifier: Apache-2.0
// A small picture of one failure scenario: the two RADIUS servers, the three cluster members, and what is down or recovering.
type State = 'ok' | 'down' | 'leader' | 'seeding' | 'restored';
interface Props {
	servers: [State, State];
	members: [State, State, State];
	sink?: State;
	acks: 'continue' | 'pause' | 'stop';
	caption: string;
}
const { servers, members, sink = 'ok', acks, caption } = Astro.props;
const label: Record<State, string> = { ok: '', down: 'down', leader: 'leader', seeding: 'seeding', restored: 'restored' };
const ackText = { continue: 'records keep being confirmed', pause: 'confirmations pause briefly', stop: 'records are not confirmed' }[acks];
---
<figure class="scenario-diagram" aria-label={caption}>
	<div class="row">
		{servers.map((s, i) => (
			<div class={`box ${s}`}><strong>RADIUS server {i === 0 ? 'A' : 'B'}</strong>{label[s] && <small>{label[s]}</small>}</div>
		))}
	</div>
	<div class={`ack ${acks}`}>{ackText}</div>
	<div class="row three">
		{members.map((s, i) => (
			<div class={`box ${s}`}><strong>Member {i + 1}</strong>{label[s] && <small>{label[s]}</small>}</div>
		))}
	</div>
	<div class="row one">
		<div class={`box sink ${sink}`}><strong>Export (sink)</strong>{label[sink] && <small>{label[sink]}</small>}</div>
	</div>
	<figcaption>{caption}</figcaption>
</figure>
<style>
	.scenario-diagram { margin: 0; padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg); }
	.row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
	.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	.one { grid-template-columns: 1fr; margin-top: var(--space-4); }
	.box { padding: var(--space-3) var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); text-align: center; font-size: var(--text-sm); }
	.box strong { display: block; }
	.box small { display: block; font-size: var(--text-xs); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
	.box.down { border-style: dashed; color: var(--color-text-faint); background: transparent; text-decoration: line-through; }
	.box.down small { text-decoration: none; color: var(--color-caution); }
	.box.leader { border-color: var(--color-primary); background: var(--color-primary-tint); }
	.box.leader small, .box.seeding small, .box.restored small { color: var(--color-primary); }
	.box.seeding, .box.restored { border-color: var(--color-primary); border-style: dotted; }
	.ack { margin: var(--space-3) 0; text-align: center; font-family: var(--font-code); font-size: var(--text-xs); color: var(--color-text-muted); }
	.ack.continue::before { content: '✓ '; color: var(--color-primary); }
	.ack.pause::before { content: '⏸ '; }
	.ack.stop::before { content: '✕ '; color: var(--color-caution); }
	figcaption { margin-top: var(--space-4); color: var(--color-text-muted); font-size: var(--text-xs); }
</style>
